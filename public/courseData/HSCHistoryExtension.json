[
  {
    "id": "course-hsc-history-extension",
    "name": "HSC History Extension",
    "outcomes": [
      {
        "code": "HX-12-01",
        "description": "analyses different approaches to history and the complexity of factors that shape historiographical perspectives in different eras"
      },
      {
        "code": "HX-12-02",
        "description": "constructs a position about an area of historiographical interpretation, and discusses and challenges other positions"
      },
      {
        "code": "HX-12-03",
        "description": "plans, conducts and presents a substantial investigation involving analysis, synthesis and evaluation of information from historical sources of differing perspectives and historiographical approaches"
      },
      {
        "code": "HX-12-04",
        "description": "communicates through detailed, well-structured texts to explain, argue, discuss, analyse or evaluate historiographical issues"
      }
    ],
