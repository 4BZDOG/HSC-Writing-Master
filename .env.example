# HSC AI Evaluator — Environment Configuration
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikeys
# SERVER-SIDE ONLY — no VITE_ prefix. This key is read by the /api/gemini
# proxy (api/gemini.ts) and the local dev middleware; it is never bundled
# into the client. In production, set it in the Vercel project's
# Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Optional — enables real multi-user auth + shared backend)
# Leave BOTH unset to keep using the built-in local mock auth (admin/admin,
# user/user). When both are set, login goes through Supabase Auth.
# Find these in your Supabase project: Settings → API.
# The anon key is public/client-safe; Row-Level Security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Demo Authentication (SEC-02)
# Enables the built-in plaintext demo logins (admin/admin, user/user).
# Automatically ON in `npm run dev`. For a production build it is OFF unless you
# explicitly set this to "true". Do NOT enable for a real-user deployment —
# replace the mock auth in services/authService.ts with a real provider first.
VITE_ENABLE_MOCK_AUTH=false

# Sentry Error Tracking (Optional)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=2.2.2

# Deployment Secrets (for GitHub Actions)
# Add these in your repository settings → Secrets and variables → Actions
# NETLIFY_AUTH_TOKEN: Your Netlify personal access token
# NETLIFY_SITE_ID: Your Netlify site ID
# SENTRY_AUTH_TOKEN: Your Sentry authentication token (for releases)
