# HSC AI Evaluator — Environment Configuration
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikeys
# SERVER-SIDE ONLY — no VITE_ prefix. This key is read by the /api/gemini
# proxy (api/gemini.ts) and the local dev middleware; it is never bundled
# into the client. In production, set it in the Vercel project's
# Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic (Claude) API Configuration — OPTIONAL
# Only needed if you switch the active AI engine to a Claude model in the
# admin "AI Engine" selector. Get a key from: https://console.anthropic.com/
# SERVER-SIDE ONLY — read by the /api/gemini proxy, never bundled into the
# client. Leave unset to run entirely on Gemini (the default).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter Configuration — OPTIONAL
# One key unlocks dozens of popular open-source models (GLM, DeepSeek, Qwen,
# Llama, Mistral, …) through a single OpenAI-compatible endpoint. Only needed
# if you switch the active AI engine to an OpenRouter model in the admin "AI
# Engine" selector. Get a key from: https://openrouter.ai/keys
# SERVER-SIDE ONLY — read by the /api/gemini proxy, never bundled into the
# client. Add more models by editing services/aiModels.ts (any OpenRouter slug).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq Configuration — OPTIONAL (FREE TIER AVAILABLE)
# Ultra-fast inference on open models (Llama 3.3 70B, Gemma 2 9B, etc.) with
# a generous free tier (30 req/min, 14,400 req/day — no billing required).
# Only needed if you switch the active AI engine to a Groq model in the admin
# "AI Engine" selector. Get a key from: https://console.groq.com/keys
# SERVER-SIDE ONLY — read by the /api/gemini proxy, never bundled into the
# client.
GROQ_API_KEY=your_groq_api_key_here

# Kimi (Moonshot AI) Configuration — OPTIONAL
# Kimi K3 is a strong reasoning model at competitive pricing. Only needed if
# you switch the active AI engine to a Kimi model in the admin "AI Engine"
# selector. Get a key from: https://platform.kimi.ai/
# SERVER-SIDE ONLY — read by the /api/gemini proxy, never bundled into the
# client.
KIMI_API_KEY=your_kimi_api_key_here

# Supabase (Optional — enables real multi-user auth + shared backend)
# Leave BOTH unset to keep using the built-in local mock auth (admin/admin,
# teacher/teacher, user/user). When both are set, login goes through
# Supabase Auth. Find these in your Supabase project: Settings → API.
# The anon key is public/client-safe; Row-Level Security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Demo accounts in PRODUCTION builds — OPT-IN. Dev builds (`npm run dev`)
# always allow the local demo accounts, but a production build refuses them
# unless this is explicitly set to true. This stops a deploy that forgot its
# Supabase vars from silently shipping a working admin/admin login. Guest
# access (read-only, local-only) is never gated.
# VITE_ENABLE_DEMO_AUTH=true

# Supabase — SERVER-SIDE copies for the AI proxy auth gate and the per-user /
# per-group daily AI quotas (no VITE_ prefix). With these set, every proxy
# call must carry a valid session AND fit the caller's daily budget
# (schema §11: role defaults admin 1000 / teacher 400 / student 60, per-user
# overrides via set_user_ai_quota).
# When BOTH are set, the /api/gemini proxy (api/_lib/auth.ts) requires a valid
# Supabase bearer token on every AI request, so anonymous callers can't spend
# the provider budget. Leave unset to keep the proxy open (mock-mode parity).
# Use the SAME values as the VITE_ pair above — the anon key is fine here; it
# is only used to verify tokens via the Auth API, never the service-role key.
# NOTE: with this enabled, guest sessions (no Supabase login) cannot make AI
# calls — that is intentional anonymous-abuse protection.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Error Tracking (Optional)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=2.2.2

# Deployment Secrets (for GitHub Actions)
# Add these in your repository settings → Secrets and variables → Actions
# NETLIFY_AUTH_TOKEN: Your Netlify personal access token
# NETLIFY_SITE_ID: Your Netlify site ID
# SENTRY_AUTH_TOKEN: Your Sentry authentication token (for releases)

# --- Stripe billing (optional) -----------------------------------------------
# Set up Stripe to enable the Plus subscription plan. Get your keys from
# https://dashboard.stripe.com/apikeys. Use TEST keys (sk_test_…, pk_test_…)
# in development — Stripe test mode is fully functional with test card numbers.
#
# Server-side (set on the API host, e.g. Vercel env vars):
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Service-role key for the webhook handler to write subscription state
# (bypasses RLS). Find it in Supabase: Settings → API → service_role key.
# NEVER expose this client-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Price IDs from Stripe: Products → Plus → Pricing. Create two prices
# (monthly recurring + yearly recurring) and paste their IDs here.
STRIPE_PLUS_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_PLUS_YEARLY_PRICE_ID=price_your_yearly_price_id
# STRIPE_SCHOOL_PRICE_ID=price_your_school_price_id

# Client-side price IDs (VITE_ prefix so they reach the browser). These
# tell the upgrade modal which prices to pass to /api/create-checkout.
# Use the SAME values as above.
VITE_STRIPE_PLUS_MONTHLY_PRICE_ID=price_your_monthly_price_id
VITE_STRIPE_PLUS_YEARLY_PRICE_ID=price_your_yearly_price_id

# Display prices shown in the upgrade modal. Presentation only — the amount
# actually charged always comes from the Stripe Price — so keep these in sync
# with the price IDs above whenever pricing changes.
# VITE_PLUS_MONTHLY_PRICE_DISPLAY=A$7.99
# VITE_PLUS_YEARLY_PRICE_DISPLAY=A$59
# VITE_PLUS_YEARLY_NOTE=Save 38% — under A$5/month

# Shown in the upgrade modal as a "Buying for a class or school?" mailto link.
# Leave unset to show a register-interest message instead.
# VITE_SCHOOL_CONTACT_EMAIL=licensing@example.com

# --- Hosting / deployment (optional) -----------------------------------------
# See DEPLOYMENT.md for the full hosting guide.

# Origin of the AI proxy when the frontend is hosted WITHOUT serverless
# functions (e.g. GitHub Pages) and the API lives elsewhere (e.g. Vercel).
# Leave unset when one host serves both (Vercel default).
# VITE_API_BASE_URL=https://your-app.vercel.app

# Server-side (set on the API host, e.g. Vercel env vars): exact origin(s)
# allowed to call /api/gemini cross-origin, comma-separated. No wildcard.
# Unset = same-origin only (default, most secure).
# ALLOWED_ORIGIN=https://yourname.github.io

# Build-time base path for sub-path hosting (set by the Pages workflow).
# DEPLOY_BASE_PATH=/HSC-Writing-Master/
